{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reveric-diagnostics",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "diagnostics.reveric.app", "custom_domain": true}],
  "r2_buckets": [{"binding": "DIAGNOSTICS", "bucket_name": "reveric-diagnosis"}],
  "ratelimits": [{"name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}]
}
