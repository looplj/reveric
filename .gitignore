#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.factory/
.worktrees
backup/
tool/evaluation/results/
tool/evaluation/local/breakdown_sources.json
dist/
!assets/plugins/*/dist/
!assets/plugins/*/dist/index.js
.qoder/
.mimocode/
.vscode
.trae/

# Patched FJS native artifacts are rebuilt from source.
/third/fjs/libfjs/target/
/third/fjs/build/
/third/fjs/darwin/fjs/Binaries/

# Local FVM SDK links and generated machine configuration
/.fvm/

# Kotlin compiler session cache generated by Android builds
/android/.kotlin/

# FVM Version Cache
.fvm/

