---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="页面未找到 — 幻界 Reveric"
  description="你访问的页面不存在或已移动。"
  canonicalPath="/404"
  useCineview={false}
  noindex={true}
>
  <main class="not-found">
    <div class="not-found-inner">
      <p class="label mono"><b>404</b>&nbsp;&nbsp;PAGE NOT FOUND</p>
      <h1 class="not-found-title">这个页面不在工作台里</h1>
      <p class="lead">页面可能已经移动或删除。你可以回到首页继续查看画布画廊与客户端下载。</p>
      <div class="ctas">
        <a class="btn" href="/">返回首页</a>
        <span class="alts">
          <a href="/#gallery">画布画廊</a>
          <a href="/#download">下载客户端</a>
        </span>
      </div>
    </div>
    <footer class="bar bar-bottom mono">
      <span>404 · © 幻界 Reveric</span>
      <span><a href="https://github.com/looplj/reveric" rel="noopener">GitHub ↗</a></span>
    </footer>
  </main>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    min-height: 100svh;
    padding: calc(var(--bar-h) + 120 * var(--u)) var(--m) calc(var(--bar-h) + 120 * var(--u));
    display: flex;
    align-items: center;
  }

  .not-found-inner {
    max-width: calc(820 * var(--u));
  }

  .not-found-title {
    margin-top: calc(24 * var(--u));
    font: 900 calc(72 * var(--u)) / 1.15 var(--font-display);
    letter-spacing: .03em;
  }

  @media (max-width: 820px) {
    .not-found {
      padding: calc(var(--bar-h) + 72px) var(--m) calc(var(--bar-h) + 72px);
    }

    .not-found-inner {
      max-width: none;
    }

    .not-found-title {
      margin-top: 16px;
      font-size: 32px;
    }
  }
</style>
