{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "preserve"
  },
  "include": [
    "sdk/**/*.d.ts",
    "*/src/**/*.ts",
    "*/test/**/*.ts",
    "*/src/**/*.tsx"
  ]
}
