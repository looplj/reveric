      "en": "Xiaoyunque - Short films",
      "zh-CN": "小云雀-短片"
    },
    "settings": {
      "fields": {
        "accessKey": {
          "type": "secret",
          "title": "Access Key",
          "required": true
        }
      },
      "actions": {
        "queryCredits": {
          "title": {
            "zh-CN": "查询积分",
            "en": "Query credits"
          },
          "requires": [
            "accessKey"
          ]
        }
      }
    }
  }
