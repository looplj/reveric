{
  "id": "reveric.memory",
  "name": {
    "zh-CN": "记忆",
    "en": "Memory"
  },
  "description": {
    "zh-CN": "管理全局与作品记忆，为聊天提供参考，并生成可确认的整理建议。",
    "en": "Manages global and per-work memories, offers them as chat references, and drafts organization suggestions for you to confirm."
  },
  "version": "1.0.0",
  "author": "Reveric",
  "pluginApiVersion": "^1",
  "main": "dist/index.js",
  "defaultEnabled": false,
  "permissions": [
    "ai.generateText"
  ],
  "settings": {
    "fields": {
      "organizeModel": {
        "type": "model",
        "title": {
          "zh-CN": "整理所用模型",
          "en": "Model for organizing"
        },
        "description": {
          "zh-CN": "后台整理记忆时调用的聊天模型；不选择则使用默认聊天模型。",
          "en": "Chat model used to organize memories in the background. Uses the default chat model when not set."
        }
      }
    }
  },
  "database": {
    "version": 1,
    "migrations": [
      {
        "version": 1,
        "source": "migrations/001.sql"
      }
    ]
  },
  "pages": {
    "manage": {
      "title": {
        "zh-CN": "记忆",
        "en": "Memory"
      },
      "location": "home.plugin",
      "protocol": "reveric-tsx-v1",
      "source": "dist/views/manage.js"
    }
  },
  "tasks": {
    "organize": {
      "title": {
        "zh-CN": "整理记忆",
        "en": "Organize memories"
      },
      "intervalMinutes": 60
    }
  }
}
