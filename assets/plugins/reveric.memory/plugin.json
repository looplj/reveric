{
  "id": "reveric.memory",
  "name": {
    "zh-CN": "创作记忆",
    "en": "Writing Memory"
  },
  "description": {
    "zh-CN": "记录跨作品的长期创作偏好，并通过后台梦境整理去重、发现冲突与提炼风格。",
    "en": "Remembers cross-work writing preferences and runs background dream consolidation to merge duplicates, spot conflicts, and refine style."
  },
  "version": "2.0.0",
  "author": "Reveric",
  "pluginApiVersion": "^1",
  "main": "dist/index.js",
  "permissions": [
    "ai.generateText"
  ],
  "settings": {
    "fields": {
      "organizeModel": {
        "type": "model",
        "title": {
          "zh-CN": "梦境整理所用模型",
          "en": "Model for dream consolidation"
        },
        "description": {
          "zh-CN": "后台梦境整理时调用的聊天模型；不选择则使用默认聊天模型。",
          "en": "Chat model used during background dream consolidation. Uses the default chat model when not set."
        }
      }
    }
  },
  "database": {
    "version": 2,
    "migrations": [
      {
        "version": 1,
        "source": "migrations/001.sql"
      },
      {
        "version": 2,
        "source": "migrations/002.sql"
      }
    ]
  },
  "pages": {
    "manage": {
      "title": {
        "zh-CN": "创作记忆",
        "en": "Writing Memory"
      },
      "location": "home.plugin",
      "protocol": "reveric-tsx-v1",
      "source": "dist/views/manage.js"
    }
  },
  "tasks": {
    "organize": {
      "title": {
        "zh-CN": "梦境整理",
        "en": "Dream consolidation"
      },
      "intervalMinutes": 60
    }
  }
}
